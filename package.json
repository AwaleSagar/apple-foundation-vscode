{
  "name": "apple-foundation-vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.2",
  "publisher": "sagarawale",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/AwaleSagar/apple-foundation-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/AwaleSagar/apple-foundation-vscode/issues"
  },
  "homepage": "https://awalelabs.cloud/apps/apple-local-chat-for-vs-code/",
  "keywords": [
    "apple",
    "apple-intelligence",
    "foundation-models",
    "on-device",
    "ai",
    "llm",
    "macos",
    "offline",
    "privacy"
  ],
  "categories": [
    "AI",
    "Chat",
    "Machine Learning"
  ],
  "engines": {
    "vscode": "^1.104.0",
    "node": ">=22"
  },
  "packageManager": "pnpm@11.0.0",
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#173C30",
    "theme": "dark"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Chat works everywhere; /commit requires a local git repository."
    },
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Local inference uses the bundled helper."
    }
  },
  "activationEvents": [],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "apple-foundation",
        "displayName": "%displayName%",
        "managementCommand": "appleFoundation.manage"
      }
    ],
    "chatParticipants": [
      {
        "id": "apple-foundation.chat",
        "name": "apple",
        "fullName": "%participant.fullName%",
        "description": "%participant.description%",
        "isSticky": true,
        "commands": [
          {
            "name": "explain",
            "description": "%participant.explain.description%"
          },
          {
            "name": "doc",
            "description": "%participant.doc.description%"
          },
          {
            "name": "commit",
            "description": "%participant.commit.description%"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "appleFoundation.manage",
        "title": "%command.manage.title%",
        "category": "%category%"
      },
      {
        "command": "appleFoundation.showStatus",
        "title": "%command.showStatus.title%",
        "category": "%category%"
      },
      {
        "command": "appleFoundation.restartServer",
        "title": "%command.restartServer.title%",
        "category": "%category%"
      },
      {
        "command": "appleFoundation.showLogs",
        "title": "%command.showLogs.title%",
        "category": "%category%"
      },
      {
        "command": "appleFoundation.runOnboarding",
        "title": "%command.runOnboarding.title%",
        "category": "%category%"
      },
      {
        "command": "appleFoundation.openChat",
        "title": "%command.openChat.title%",
        "category": "%category%"
      },
      {
        "command": "appleFoundation.explainSelection",
        "title": "%command.explainSelection.title%",
        "category": "%category%"
      },
      {
        "command": "appleFoundation.documentSelection",
        "title": "%command.documentSelection.title%",
        "category": "%category%"
      },
      {
        "command": "appleFoundation.draftCommit",
        "title": "%command.draftCommit.title%",
        "category": "%category%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "appleFoundation.newChat",
        "title": "%command.newChat.title%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "appleFoundation.stop",
        "title": "%command.stop.title%",
        "category": "%category%"
      }
    ],
    "walkthroughs": [
      {
        "id": "appleFoundation.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "checkSetup",
            "title": "%walkthrough.checkSetup.title%",
            "description": "%walkthrough.checkSetup.description%",
            "media": {
              "markdown": "media/walkthrough/check-setup.md"
            },
            "completionEvents": [
              "onCommand:appleFoundation.runOnboarding"
            ]
          },
          {
            "id": "pickModel",
            "title": "%walkthrough.pickModel.title%",
            "description": "%walkthrough.pickModel.description%",
            "media": {
              "markdown": "media/walkthrough/pick-model.md"
            },
            "completionEvents": [
              "onCommand:appleFoundation.openChat"
            ]
          },
          {
            "id": "tryApple",
            "title": "%walkthrough.tryApple.title%",
            "description": "%walkthrough.tryApple.description%",
            "media": {
              "markdown": "media/walkthrough/try-apple.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "%displayName%",
      "properties": {
        "appleFoundation.model.maxOutputTokens": {
          "type": "number",
          "default": 1024,
          "minimum": 16,
          "maximum": 8192,
          "description": "%config.maxOutputTokens.description%"
        },
        "appleFoundation.model.maxContextTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32768,
          "markdownDescription": "%config.maxContextTokens.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "appleFoundation",
          "title": "Local Chat",
          "icon": "media/chat/activity.svg"
        }
      ]
    },
    "views": {
      "appleFoundation": [
        {
          "id": "appleFoundation.localChat",
          "name": "Local Chat",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "appleFoundation.explainSelection",
          "when": "editorHasSelection",
          "group": "appleLocal@0"
        },
        {
          "command": "appleFoundation.documentSelection",
          "when": "editorHasSelection",
          "group": "appleLocal@1"
        }
      ],
      "scm/title": [
        {
          "command": "appleFoundation.draftCommit",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "appleFoundation.newChat",
          "when": "view == appleFoundation.localChat",
          "group": "navigation"
        },
        {
          "command": "appleFoundation.showStatus",
          "when": "view == appleFoundation.localChat",
          "group": "1_model@1"
        },
        {
          "command": "appleFoundation.showLogs",
          "when": "view == appleFoundation.localChat",
          "group": "1_model@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "sh scripts/build-helper.sh && node esbuild.mjs --production",
    "watch": "sh scripts/build-helper.sh && node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:vscode": "sh scripts/build-helper.sh && node esbuild.mjs && node esbuild.mjs --tests && VSCODE_TEST=true vscode-test",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run test",
    "package": "vsce package --no-dependencies --target darwin-arm64",
    "publish:marketplace": "vsce publish --no-dependencies --target darwin-arm64",
    "changeset": "changeset",
    "version": "changeset version",
    "prepare": "husky",
    "build:helper": "sh scripts/build-helper.sh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "~1.104.0",
    "@vitest/coverage-v8": "^3.2.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "husky": "^9.1.0",
    "lint-staged": "^16.1.0",
    "markdown-it": "14.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
